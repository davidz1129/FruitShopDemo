{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build API (stop running app)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process -Name 'FruitShop.Api' -ErrorAction SilentlyContinue | Stop-Process -Force; dotnet build .\\FruitShop.Api\\FruitShop.Api.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}